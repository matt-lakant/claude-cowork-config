# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp

# Microsoft Office lock & temp files
~$*
*.tmp

# The job-search skills treat PDFs as stale copies of a .docx that is about
# to change. Keep the .docx as the source of truth; don't version the export.
*.pdf

# Local scratch
/tmp/

# Personal data lives in the Obsidian vault (single source of truth) and in
# OneDrive for job-search working files. It was removed from this repo on
# 2026-09-10 so identity and application data are not versioned here.
/Personal Data/

# Session deliverables belong in the project folder under
# OneDrive\Documents\Claude\Projects\<Project Name>, never here.
/Claude outputs/
