{
  "description": "Loads Matt's standing rules into every session.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/context/standing-rules.md\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
